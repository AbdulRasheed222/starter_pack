# Copy to backend/.env for local development. Never commit the real .env.

ENVIRONMENT=development

# Local Postgres from docker-compose.yml. In production, your provider's connection string
# with the postgresql+psycopg:// prefix.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# Comma-separated origins allowed to call the API from a browser (the web app's URL).
CORS_ORIGINS=http://localhost:3000
# The web app, for invite links.
SITE_URL=http://localhost:3000

# Sign-in: the Clerk application's Frontend API URL (Clerk dashboard, API keys).
# See docs/clerk.md for the session token setting invites need.
CLERK_ISSUER=

MAX_WORKSPACES_PER_USER=5
INVITE_DAYS=7
INVITE_REQUIRES_EMAIL_MATCH=true

# --- AI (see docs/ai.md) ---
# anthropic (Claude), openai (any OpenAI-compatible server: OpenAI, Ollama, vLLM) or fake.
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
ANTHROPIC_API_KEY=
# For AI_PROVIDER=openai. Ollama: http://localhost:11434/v1 and no key.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Uncomment for a model missing from ai/pricing.py (0 and 0 for one you host yourself).
# AI_PRICE_INPUT_PER_MTOK=0
# AI_PRICE_OUTPUT_PER_MTOK=0
# Spending cap per workspace per month, in USD.
AI_MONTHLY_BUDGET_USD=5

# Document search. The model is downloaded on first use (about 1 GB).
EMBEDDER=fastembed
# EMBEDDING_CACHE_DIR=./.models
